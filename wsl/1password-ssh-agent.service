# Relays 1Password's SSH agent (Windows named pipe -> WSL unix socket).
# Installed by dotfiles: dotbot/wsl.yaml links this into ~/.config/systemd/user/
[Unit]
Description=1Password SSH agent relay (Windows named pipe -> WSL unix socket)

[Service]
Type=simple
# %t is XDG_RUNTIME_DIR (/run/user/1000) on tmpfs, so no stale socket survives a
# reboot; the ExecStartPre is only a safety net for restarts.
ExecStartPre=-/usr/bin/rm -f %t/1password-agent.sock
# The EXEC: address must stay quoted: it is a single socat argument containing
# spaces, and systemd splits unquoted ExecStart= values on whitespace.
ExecStart=/usr/bin/socat UNIX-LISTEN:%t/1password-agent.sock,fork,mode=0600 "EXEC:/usr/local/bin/npiperelay.exe -ei -s //./pipe/openssh-ssh-agent,nofork"
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
